# Copy to .env and fill in. Never commit .env.

# Public name of this server (a DNS A record must point here). Caddy gets a TLS certificate for it.
DOMAIN=ai.example.com.sa

# Long random key. Neotec Coworker sends it as the provider's API key.
# Generate one with:  openssl rand -hex 32
API_KEY=change-me

# Which model server Caddy forwards to: ollama:11434 (Ollama profile) or vllm:8000 (vLLM profile).
UPSTREAM=ollama:11434

# ---- Ollama profile -------------------------------------------------------------------------------
# Models to download on first start (space separated, as named in the Ollama library).
# Use "Find models on this server" in Neotec Coworker afterwards to pick the exact id.
OLLAMA_MODELS=qwen3.6:27b
# Context window. Coworkers send tool definitions; below 16k they lose instructions.
OLLAMA_CONTEXT_LENGTH=32768
# How long a model stays loaded after the last request.
OLLAMA_KEEP_ALIVE=30m

# ---- vLLM profile ---------------------------------------------------------------------------------
# Hugging Face repository id of the model (see docs/OPEN_MODELS.md for the catalogue).
VLLM_MODEL=Qwen/Qwen3.6-27B
# Name the model is served under (what you enter as Model in Neotec Coworker).
VLLM_SERVED_NAME=qwen3.6-27b
# Tool-call parser for the model family: hermes (Qwen), openai (gpt-oss), mistral, llama4_pythonic (Llama 4).
VLLM_TOOL_PARSER=hermes
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
# Number of GPUs to split the model across.
VLLM_TENSOR_PARALLEL=1
# Only needed for gated repositories.
HF_TOKEN=
